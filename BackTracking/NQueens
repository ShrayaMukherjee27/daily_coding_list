class Solution {
public:
    bool isOk(int i, int j, vector<string> &board){
        int n = board.size();
        for(int c = 0 ; c<j; c++) if(board[i][c] == 'Q') return false;
        for(int r = 0 ; r<i; r++) if(board[r][j] == 'Q') return false;
        for(int r = i-1, c = j-1 ; r>=0 && c>=0; r--, c--) if(board[r][c] == 'Q') return false;
        for(int r = i-1, c = j+1 ; r>=0 && c<n ; r--, c++) if(board[r][c] == 'Q') return false;
        return true;
    }
    void nQueens(int i, int j, int n, vector<string> &board, vector<vector<string>> &ans){
        if(i == n) {
            ans.push_back(board);
            return;
        }
        //if(j == n) nQueens(i+1,0,n,board,ans);
        for(int c = j; c < n ; c++){
            if(isOk(i,c,board)){
                board[i][c] = 'Q';
                nQueens(i+1,0,n,board,ans);
                board[i][c] = '.';
            }
        }

    }
    vector<vector<string>> solveNQueens(int n) {
        string s(n,'.');
        vector<string> board(n, s);
        vector<vector<string>> ans;
        nQueens(0,0,n,board,ans);
        return ans;
    }
};
